

models:
  - name: Qwen Coder
    provider: ollama
    model: qwen2.5-coder:7b
    roles:
      - chat
      - edit
      - apply
      - autocomplete

  - name: LLaVA Vision
    provider: ollama
    model: llava:latest
    roles:
      - chat

  - name: Nomic Embed
    provider: ollama
    model: nomic-embed-text:latest
    roles:
      - embed